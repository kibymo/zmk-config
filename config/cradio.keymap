//#include <behaviors/num_word.dtsi>

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <160>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 32 33>;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <160>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31>;
        };

        caps_word: caps_word {
            compatible = "zmk,behavior-caps-word";
            #binding-cells = <0>;
            continue-list = <UNDERSCORE BACKSPACE DELETE>;
        };

        //        num_word: num_word {
        //            compatible = "zmk,behavior-auto-layer";
        //            #binding-cells = <1>;
        //            continue-list = <BACKSPACE DELETE DOT COMMA PLUS MINUS STAR FSLH EQUAL>;
        //            ignore-numbers;
        //        };
        //        nav_word: nav_word {
        //            compatible = "zmk,behavior-auto-layer";
        //            #binding-cells = <1>;
        //            continue-list = <LEFT DOWN UP RIGHT PG_DN PG_UP R X D U>;
        //            ignore-modifiers;
        //        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };

    combos {
        compatible = "zmk,combos";

        combo_under {
            bindings = <&kp UNDER>;
            key-positions = <5 6>;
            timeout-ms = <50>;
        };

        combo_minus {
            bindings = <&kp MINUS>;
            key-positions = <15 16>;
            timeout-ms = <50>;
        };

        combo_plus {
            bindings = <&kp COLON>;
            key-positions = <6 7>;
            timeout-ms = <50>;
        };

        combo_equal {
            bindings = <&kp SEMI>;
            key-positions = <16 17>;
            timeout-ms = <50>;
        };

        combo_colon {
            bindings = <&kp DQT>;
            key-positions = <7 8>;
            timeout-ms = <50>;
        };

        combo_semi {
            bindings = <&kp SQT>;
            key-positions = <17 18>;
            timeout-ms = <50>;
        };

        combo_dqt {
            bindings = <&kp PLUS>;
            key-positions = <8 9>;
            timeout-ms = <50>;
        };

        combo_sqt {
            bindings = <&kp EQUAL>;
            key-positions = <18 19>;
            timeout-ms = <50>;
        };

        combo_lbkt {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <25 26>;
            timeout-ms = <50>;
        };

        combo_rbkt {
            bindings = <&kp RBKT>;
            key-positions = <26 27>;
            timeout-ms = <50>;
        };

        combo_pipe {
            bindings = <&kp PIPE>;
            key-positions = <19 9>;
            timeout-ms = <50>;
        };

        combo_qmark {
            bindings = <&kp BSLH>;
            key-positions = <19 29>;
            timeout-ms = <50>;
        };

        combo_excl {
            bindings = <&kp EXCL>;
            key-positions = <1 0>;
            timeout-ms = <50>;
        };

        combo_percent {
            bindings = <&kp PERCENT>;
            key-positions = <11 10>;
            timeout-ms = <50>;
        };

        combo_at {
            bindings = <&kp AT>;
            key-positions = <2 1>;
            timeout-ms = <50>;
        };

        combo_caret {
            bindings = <&kp CARET>;
            key-positions = <12 11>;
            timeout-ms = <50>;
        };

        combo_hash {
            bindings = <&kp HASH>;
            key-positions = <3 2>;
            timeout-ms = <50>;
        };

        combo_amps {
            bindings = <&kp AMPS>;
            key-positions = <13 12>;
            timeout-ms = <50>;
        };

        combo_dllr {
            bindings = <&kp DLLR>;
            key-positions = <4 3>;
            timeout-ms = <50>;
        };

        combo_astrk {
            bindings = <&kp ASTRK>;
            key-positions = <14 13>;
            timeout-ms = <50>;
        };

        combo_lbrc {
            bindings = <&kp LBRC>;
            key-positions = <22 23>;
            timeout-ms = <50>;
        };

        combo_rbrc {
            bindings = <&kp RBRC>;
            key-positions = <23 24>;
            timeout-ms = <50>;
        };

        combo_lpar {
            bindings = <&kp LPAR>;
            key-positions = <21 20>;
            timeout-ms = <50>;
        };

        combo_rpar {
            bindings = <&kp RPAR>;
            key-positions = <21 22>;
            timeout-ms = <50>;
        };

        combo_tilde {
            bindings = <&kp TILDE>;
            key-positions = <0 10>;
            timeout-ms = <50>;
        };

        combo_grave {
            bindings = <&kp GRAVE>;
            key-positions = <10 20>;
            timeout-ms = <50>;
        };

        combo_n1 {
            bindings = <&kp N1>;
            key-positions = <16 26>;
            timeout-ms = <50>;
        };

        combo_n2 {
            bindings = <&kp N2>;
            key-positions = <27 17>;
            timeout-ms = <50>;
        };

        combo_n3 {
            bindings = <&kp N3>;
            key-positions = <28 18>;
            timeout-ms = <50>;
        };

        combo_n4 {
            bindings = <&kp N4>;
            key-positions = <6 16>;
            timeout-ms = <50>;
        };

        combo_n5 {
            bindings = <&kp N5>;
            key-positions = <7 17>;
            timeout-ms = <50>;
        };

        combo_n6 {
            bindings = <&kp N6>;
            key-positions = <8 18>;
            timeout-ms = <50>;
        };

        combo_n7 {
            bindings = <&kp N7>;
            key-positions = <6 26>;
            timeout-ms = <50>;
        };

        combo_n8 {
            bindings = <&kp N8>;
            key-positions = <7 27>;
            timeout-ms = <50>;
        };

        combo_n9 {
            bindings = <&kp N9>;
            key-positions = <8 28>;
            timeout-ms = <50>;
        };

        combo_n0 {
            bindings = <&kp N0>;
            key-positions = <33 25>;
            timeout-ms = <50>;
        };

        combo_del {
            bindings = <&kp DEL>;
            key-positions = <29 28>;
            timeout-ms = <50>;
        };

        combo_caps_word {
            bindings = <&caps_word>;
            key-positions = <0 20>;
            timeout-ms = <50>;
        };

        //        combo_nav_word_layer3 {
        //            bindings = <&nav_word 3>;
        //            key-positions = <25 5>;
        //            timeout-ms = <50>;
        //        };
        //        combo_num_word_layer2 {
        //            bindings = <&num_word 2>;
        //            key-positions = <16 18>;
        //            timeout-ms = <50>;
        //        };

        combo_esc {
            bindings = <&kp ESC>;
            key-positions = <0 11>;
        };

        combo_esc2 {
            bindings = <&kp ESC>;
            key-positions = <12 1>;
        };

        combo_tab {
            bindings = <&kp TAB>;
            key-positions = <10 13>;
        };

        combo_tab2 {
            bindings = <&kp TAB>;
            key-positions = <0 12>;
        };

        combo_enter {
            bindings = <&kp ENTER>;
            key-positions = <16 19>;
        };

        combo_tog3 {
            bindings = <&tog 3>;
            key-positions = <6 15>;
        };

        combo_tog4 {
            bindings = <&tog 4>;
            key-positions = <5 25>;
        };

        combo_tog1 {
            bindings = <&tog 1>;
            key-positions = <15 17>;
        };

        combo_ctrl_c {
            bindings = <&kp RC(C)>;
            key-positions = <20 23>;
            timeout-ms = <50>;
        };

        combo_ctrl_v {
            bindings = <&kp RC(V)>;
            key-positions = <20 24>;
            timeout-ms = <50>;
        };

        combo_ctrl_b {
            bindings = <&kp RC(B)>;
            key-positions = <20 4>;
            timeout-ms = <50>;
        };

        combo_ctrl_z {
            bindings = <&kp RC(Z)>;
            key-positions = <20 30>;
            timeout-ms = <50>;
        };

        combo_ctrl_r {
            bindings = <&kp RC(R)>;
            key-positions = <20 2>;
            timeout-ms = <50>;
        };

        combo_ctrl_w {
            bindings = <&kp RC(W)>;
            key-positions = <20 3>;
            timeout-ms = <50>;
        };

        combo_meta_q {
            bindings = <&kp RG(Q)>;
            key-positions = <0 23>;
        };

        combo_ctrl_d {
            bindings = <&kp RC(D)>;
            key-positions = <20 1>;
            timeout-ms = <50>;
        };
    };

    macros {
        macro_ckcu: macro_ckcu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(K) &kp LC(U)>, <&macro_press>;

            label = "MACRO_CKCU";
        };

        macro_ckcc: macro_ckcc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(K) &kp LC(C)>;
            label = "MACRO_CKCC";
        };

        macro_grep: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp PIPE &kp G &kp R &kp E &kp P &kp SPACE &kp MINUS &kp I &kp SPACE>;
            label = "NEW_MACRO";
        };

        macro_wq: macro_wq {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESC &kp COLON &kp W &kp Q &kp EXCL>;
            label = "MACRO_WQ";
        };

        macro_q: macro_q {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESC &kp COLON &kp Q &kp EXCL &kp RET>;
            label = "MACRO_Q";
        };

        macro_stty: macro_Backspace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp T &kp T &kp Y &kp SPACE &kp E &kp R &kp A &kp S &kp E &kp SPACE &kp LC(V) &kp BACKSPACE>;
            label = "MACRO_BACKSPACE";
        };

        macro_p1: macro_p1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp P &kp O &kp N &kp Y>;
            label = "MACRO_P1";
        };

        macro_p2: macro_p2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N2 &kp N0 &kp N2 &kp N4 &kp AT>;
            label = "MACRO_P2";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        workman_layer {
            bindings = <
&kp Q         &kp D        &kp R         &kp W      &kp B              &kp J             &kp F      &kp U         &kp P             &kp BACKSPACE
&kp A         &kp S        &hml LSHFT H  &lt 2 T    &lt 3 G            &lt 3 Y           &lt 2 N    &hmr RSHFT E  &kp O             &kp I
&hml LCTRL Z  &hml LALT X  &kp M         &kp C      &hml LEFT_GUI V    &hmr RIGHT_GUI K  &kp L      &kp COMMA     &hmr RALT PERIOD  &hmr LCTRL SLASH
                                         &lt 5 ESC  &kp SPACE          &kp ENTER         &lt 4 TAB
            >;
        };

        qwert_layer {
            bindings = <
&kp Q         &kp W        &kp E         &kp R      &kp T              &kp Y             &kp U            &kp I         &kp O             &kp P
&kp A         &kp S        &hml LSHFT D  &lt 3 F    &lt 3 G            &lt 3 H           &lt 2 J          &hmr RSHFT K  &kp L             &kp ENTER
&hml LCTRL Z  &hml LALT X  &kp C         &kp V      &hml LEFT_GUI B    &hmr RIGHT_GUI N  &kp M            &kp COMMA     &hmr RALT PERIOD  &hmr LCTRL SLASH
                                         &lt 5 TAB  &kp SPACE          &kp ENTER         &lt 4 BACKSPACE
            >;
        };

        sym_layer {
            bindings = <
&kp TILDE  &kp EXCL   &kp AT     &kp POUND  &kp DLLR    &kp UNDER  &kp COLON  &kp DQT  &kp PLUS   &kp PIPE
&kp GRAVE  &kp PRCNT  &kp CARET  &kp AMPS   &kp STAR    &kp MINUS  &kp SEMI   &kp SQT  &kp EQUAL  &kp BSLH
&none      &kp LPAR   &kp RPAR   &kp LBRC   &kp RBRC    &kp LBKT   &kp RBKT   &kp LT   &kp GT     &kp QMARK
                                 &trans     &trans      &trans     &trans
            >;
        };

        fun_num_layer {
            bindings = <
&trans  &kp F1  &kp F2   &kp F3   &kp F4     &kp UP    &kp N7  &kp N8  &kp N9  &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8     &kp LEFT  &kp N4  &kp N5  &kp N6  &kp RIGHT
&trans  &kp F9  &kp F10  &kp F11  &kp F12    &kp DOWN  &kp N1  &kp N2  &kp N3  &kp DOT
                         &trans   &trans     &trans    &kp N0
            >;
        };

        nav_layer {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none   &kp HOME  &mkp MCLK     &kp PAGE_UP    &trans
&out OUT_USB  &out OUT_TOG  &out OUT_BLE  &none         &none           &none   &kp END   &kp UP_ARROW  &kp PAGE_DOWN  &none
&none         &none         &none         &none         &none           &none   &kp LEFT  &kp DOWN      &kp RIGHT      &none
                                          &trans        &trans          &trans  &trans
            >;
        };

        macro_layer {
            bindings = <
&macro_q   &tog 1       &macro_p1  &macro_wq             &none                &none  &none  &none  &kp PRINTSCREEN  &none
&none      &macro_stty  &macro_p2  &kp LC(LA(SPACE))     &macro_grep          &none  &none  &none  &none            &none
&kp LC(Z)  &kp X        &none      &kp LS(LA(LC(DOWN)))  &kp LC(LS(SPACE))    &none  &none  &none  &none            &none
                                   &none                 &none                &none  &none
            >;
        };
    };
};
